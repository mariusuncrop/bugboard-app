# Copy to .env — every value below is already the default, so .env is optional.

# Port the API (and, in production, the built frontend) listens on.
PORT=4000

# Port the Vite dev server listens on.
WEB_PORT=5173

# Secret used to sign session tokens. Change it for any real deployment.
AUTH_SECRET=dev-only-secret-change-me

# Exposes POST /api/test/reset so test suites can restore a known database.
# Must be left off in production.
ENABLE_TEST_ENDPOINTS=true

# Artificial latency (ms) added to GET /api/stats, to give the UI a real
# loading state worth testing.
STATS_DELAY_MS=1200
